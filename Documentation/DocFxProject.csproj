<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Compile the Unity project's C# source for DocFX metadata generation.
      Tutorial scripts are excluded because they are not part of this POC.
    -->
    <Compile Include="../Assets/**/*.cs" Exclude="../Assets/Tutorials/**/*.cs" />
    <!--
      Metadata-only stand-in for the Cinemachine types referenced by the
      sample project. This is not used by the Unity project at runtime.
    -->
    <ProjectReference Include="Stubs/CinemachineStub/CinemachineStub.csproj" />
  </ItemGroup>
  <Target Name="AddUnityReferences" BeforeTargets="ResolveAssemblyReferences">
    <!--
      DocFX compiles the source outside the Unity editor, so the matching
      Unity managed assemblies need to be supplied explicitly.

      CI places them under lib/UnityEngine. Local builds can use
      UNITY_MANAGED_PATH or the Unity Hub fallback below.
    -->
    <PropertyGroup>
      <UnityManagedPath Condition="'$(UNITY_MANAGED_PATH)' != ''">$(UNITY_MANAGED_PATH)</UnityManagedPath>
      <UnityManagedPath Condition="'$(UnityManagedPath)' == '' and Exists('$(MSBuildProjectDirectory)/../lib/UnityEngine')">$(MSBuildProjectDirectory)/../lib/UnityEngine</UnityManagedPath>
      <UnityManagedPath Condition="'$(UnityManagedPath)' == '' and $([MSBuild]::IsOSPlatform('Windows')) and Exists('C:\Program Files\Unity\Hub\Editor\2022.3.22f1\Editor\Data\Managed\UnityEngine')">C:\Program Files\Unity\Hub\Editor\2022.3.22f1\Editor\Data\Managed\UnityEngine</UnityManagedPath>
    </PropertyGroup>
    <ItemGroup Condition="'$(UnityManagedPath)' != ''">
      <_UnityDll Include="$(UnityManagedPath)/*.dll" />
    </ItemGroup>
    <Warning Condition="'@(_UnityDll)' == ''" Text="Unity managed DLLs not found. Set UNITY_MANAGED_PATH or populate lib/UnityEngine." />
    <ItemGroup>
      <Reference Include="%(_UnityDll.Filename)">
        <HintPath>%(_UnityDll.FullPath)</HintPath>
        <Private>false</Private>
      </Reference>
    </ItemGroup>
  </Target>
</Project>
